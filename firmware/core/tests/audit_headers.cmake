# Fails if any core library source/header includes a libc header outside
# the portability allowlist (no stdio, stdlib/malloc, time, etc.).
set(ALLOWED stdint.h stdbool.h stddef.h string.h math.h)
file(GLOB FILES ${SRC_DIR}/src/*.c ${SRC_DIR}/include/*.h ${SRC_DIR}/hal/*.h)
set(bad "")
foreach(f IN LISTS FILES)
  file(STRINGS ${f} incs REGEX "^[ \t]*#[ \t]*include[ \t]*<")
  foreach(i IN LISTS incs)
    string(REGEX REPLACE ".*<([^>]+)>.*" "\\1" h "${i}")
    list(FIND ALLOWED ${h} idx)
    if(idx EQUAL -1)
      list(APPEND bad "${f}: <${h}>")
    endif()
  endforeach()
  file(STRINGS ${f} allocs REGEX "(malloc|calloc|realloc|free)[ \t]*\\(")
  if(allocs)
    list(APPEND bad "${f}: dynamic allocation")
  endif()
endforeach()
if(bad)
  message(FATAL_ERROR "Disallowed in core:\n${bad}")
endif()
message(STATUS "core libc audit OK (${FILES})")
